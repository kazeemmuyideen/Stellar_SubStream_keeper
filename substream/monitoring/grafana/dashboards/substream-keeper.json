{
  "uid": "substream-keeper",
  "title": "SubStream Keeper",
  "tags": ["substream", "stellar", "keeper"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Consecutive failures",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "substream-prometheus" },
          "expr": "keeper_consecutive_failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Seconds since last success",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "substream-prometheus" },
          "expr": "time() - keeper_last_success_time_seconds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 300 },
              { "color": "red", "value": 900 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tick rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "substream-prometheus" },
          "expr": "rate(keeper_ticks_total[5m])",
          "legendFormat": "ticks/s"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "substream-prometheus" },
          "expr": "rate(keeper_tick_failures_total[5m])",
          "legendFormat": "failures/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Due subscriptions and charge attempts",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "substream-prometheus" },
          "expr": "rate(keeper_due_found_total[5m])",
          "legendFormat": "due/s"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "substream-prometheus" },
          "expr": "rate(keeper_charge_attempts_total[5m])",
          "legendFormat": "attempts/s"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "substream-prometheus" },
          "expr": "rate(keeper_charge_failures_total[5m])",
          "legendFormat": "thrown/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Charge outcomes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "substream-prometheus" },
          "expr": "sum by (outcome) (rate(keeper_charge_outcomes_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
